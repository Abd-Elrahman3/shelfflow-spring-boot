        "operationId": "post_api_v1_members",
        "summary": "201 Member; 400 invalid; 409 duplicate",
        "description": "{email,displayName}; see docs/API_REQUIREMENTS.md for rule-level behavior.",
        "parameters": [],
        "responses": {
          "201": {
            "description": "201 Member; 400 invalid; 409 duplicate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberView"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "URI of created resource"
              }
            }
          },
          "400": {
            "description": "201 Member; 400 invalid; 409 duplicate",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "201 Member; 400 invalid; 409 duplicate",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
