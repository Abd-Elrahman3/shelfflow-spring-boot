    "/api/v1/books": {
      "post": {
        "operationId": "post_api_v1_books",
        "summary": "201 Book; 409 duplicate ISBN",
        "description": "{isbn,title,authors:[string]}; see docs/API_REQUIREMENTS.md for rule-level behavior.",
        "parameters": [],
        "responses": {
          "201": {
            "description": "201 Book; 409 duplicate ISBN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookView"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "URI of created resource"
              }
            }
          },
          "400": {
            "description": "Invalid request or authorization failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "201 Book; 409 duplicate ISBN",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "isbn": {
                    "type": "string",
                    "pattern": "^[0-9]{13}$"
                  },
                  "title": {
                    "type": "string"
                  },
                  "authors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "isbn",
                  "title",
                  "authors"
                ]
              }
            }
          }
        }
      },
      "get": {
        "operationId": "get_api_v1_books",
        "summary": "200 Page<Book>",
        "description": "page,size,title query parameters; see docs/API_REQUIREMENTS.md for rule-level behavior.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "title",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "200 Page<Book>",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or authorization failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
